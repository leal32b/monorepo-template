# Copy to apps/web/.env.local (git-ignored) to override. Vite inlines VITE_* values into the
# bundle at build time: they are public, never a secret.

# Origin of the API, no path or trailing slash. Empty means same origin (the Vite dev proxy).
# Production sets it in the deploy workflow, e.g. https://<service>.onrender.com
VITE_API_BASE_URL=