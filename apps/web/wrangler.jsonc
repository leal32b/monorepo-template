// The web Worker: the Vite build as static assets, and a script for the paths that are not a file
// (worker/worker.ts, ADR 0019 and ADR 0022). The deploy sets API_ORIGIN and the PROXY_SECRET
// secret; `wrangler dev` reads them from .dev.vars (git-ignored).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monorepo-template-web",
  "compatibility_date": "2026-10-28",
  "main": "./worker/worker.ts",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    // The script runs first on /api/*, page loads included: OAuth callbacks and links in emails.
    "run_worker_first": ["/api/*"]
  }
}
