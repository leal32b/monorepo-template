# Headers Cloudflare adds to the static assets (https://developers.cloudflare.com/workers/static-assets/headers/).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'

# Vite puts a content hash in every file name under /assets: a new build is a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
