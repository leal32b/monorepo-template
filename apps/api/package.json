{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db": "pglite-server --db=.data --port=5433",
    "db:stop": "pid=$(lsof -tiTCP:5433 -sTCP:LISTEN) && kill -TERM $pid",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "dev": "pnpm migrate && tsx watch --env-file-if-exists=.env src/main.ts | pino-pretty",
    "build": "node build.ts",
    "start": "node --enable-source-maps dist/migrate.js && node --enable-source-maps dist/main.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-socket": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "esbuild": "catalog:",
    "pino-pretty": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "better-auth": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  }
}
