# Copy to apps/api/.env (git-ignored). These values are for local development only.

# Postgres: `pnpm db` serves a local PGlite on 5433 (ADR 0013). Production uses Neon with sslmode=require.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable

# `pnpm dev` runs the API with DATABASE_POOL_SIZE=1, which PGlite needs: it is one session, and mixes
# up the statements of connections that wait behind a transaction (ADR 0055). Production leaves it
# unset: a pool of 5 (ADR 0047).

# Origin of the web app (ADR 0019): writes from any other origin are refused. In dev, the Vite
# server: open the app at this exact origin (127.0.0.1 is another origin).
WEB_ORIGIN=http://localhost:5173

# Web origins allowed by CORS, comma-separated (ADR 0015). Empty in dev: the Vite proxy is same-origin.
CORS_ORIGINS=

# Secret the web Worker sends (ADR 0022), `openssl rand -hex 32`. Empty in dev: every caller is
# served. Required when WEB_ORIGIN is https.
PROXY_SECRET=

# Better Auth's secret (ADR 0020): it signs session cookies. Required, at least 32 characters:
# `openssl rand -hex 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email through Resend (ADR 0021): both or neither. Empty in dev: emails go to the log, links
# included. Required when WEB_ORIGIN is https. EMAIL_FROM is `Name <address>` on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=

# Google sign-in (ADR 0020): both or neither; empty turns Google off. In the Google Cloud console
# the OAuth client's redirect URI is `<WEB_ORIGIN>/api/auth/callback/google`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Background work (ADR 0056). JOB_WORKER: `on` (default) runs the jobs in the API process; `off` when
# a worker of its own does (`pnpm --filter @repo/api worker`, `node dist/worker.js` in the image).
# JOB_IDLE_POLL_SECONDS: the longest an idle worker sleeps before it looks again, 3600 by default
# (an enqueue in the same process wakes it at once); a few seconds for a worker in its own process.
JOB_WORKER=
JOB_IDLE_POLL_SECONDS=

LOG_LEVEL=debug

# The version running (ADR 0046), on every log line and in /api/health. The image build sets it to
# the commit; unset, it is `dev`.
RELEASE=
