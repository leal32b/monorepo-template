# Copy to apps/api/.env (git-ignored). These values are for local development only.

# Postgres: `pnpm db` serves a local PGlite on 5433 (ADR 0013). Production uses Neon with sslmode=require.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable

# Origin of the web app (ADR 0019): writes from any other origin are refused. In dev, the Vite
# server: open the app at this exact origin (127.0.0.1 is another origin).
WEB_ORIGIN=http://localhost:5173

# Web origins allowed by CORS, comma-separated (ADR 0015). Empty in dev: the Vite proxy is same-origin.
CORS_ORIGINS=

# Secret the web Worker sends (ADR 0022), `openssl rand -hex 32`. Empty in dev: every caller is
# served. Required when WEB_ORIGIN is https.
PROXY_SECRET=

LOG_LEVEL=debug
