{
  "name": "monorepo-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:deps": "depcruise apps packages",
    "lint:fsd": "pnpm --filter @repo/web lint:fsd",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "db": "pnpm --filter @repo/api db",
    "dev": "pnpm --parallel --filter @repo/api --filter @repo/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.12.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "lefthook": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
