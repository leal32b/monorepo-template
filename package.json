{
  "name": "monorepo-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
