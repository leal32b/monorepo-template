{
  "name": "monorepo-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:deps": "depcruise apps packages",
    "lint:fsd": "pnpm --filter @repo/web lint:fsd",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "db": "pnpm --filter @repo/api db",
    "dev": "pnpm --parallel --filter @repo/api --filter @repo/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.12.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "^18.7.0",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
