{
  "name": "monorepo-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:deps": "depcruise apps packages",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "dev": "pnpm --parallel --filter @repo/api --filter @repo/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@swc/core": "^1.16.18",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "^18.6.0",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
